# Project-specific Kconfig defaults.
# The per-environment sdkconfig.* files are regenerated by ESP-IDF from these
# defaults, so we only keep the non-default options the firmware relies on.

# Required by main.c: esp_pm_configure() + light sleep duty-cycling.
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
# esp_pm_configure(light_sleep_enable=true) returns ESP_ERR_NOT_SUPPORTED
# unless tickless idle is enabled (see esp_pm/pm_impl.c).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
